# Mẫu biến môi trường cho Gemini WebAPI Provider.
# Copy file này thành .env (cp .env.example .env) khi triển khai trên máy hoặc VPS.

# ---------- Cấu hình Mạng & Bảo mật ----------
# Để localhost (hoặc 127.0.0.1) để chỉ các Backend trên cùng VPS gọi được, chặn truy cập từ ngoài internet
GEMINI_HOST=localhost
GEMINI_PORT=8000

# Secret Key bắt buộc trong header "Authorization: Bearer <key>" hoặc "X-API-Key: <key>" khi gọi /v1/*
# BẮT BUỘC, dài hơn 10 ký tự, không có giá trị mặc định (thiếu thì server không khởi động). Sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Dùng cùng giá trị cho GEMINI_API_KEY trong .env của exam-epu-web.
GEMINI_API_KEY=

# ---------- Hiệu năng & Cookie ----------
# Số luồng xử lý song song tối đa qua Semaphore
GEMINI_MAX_CONCURRENCY=3

# ---------- Giới hạn request ----------
# Kích thước tối đa 1 request (MB) – chặn trước khi đọc vào RAM, quá thì trả 413
GEMINI_MAX_BODY_MB=20
# Số file đính kèm tối đa / request và dung lượng tối đa mỗi file (MB)
GEMINI_MAX_FILES=8
GEMINI_MAX_FILE_MB=8
# Chờ hàng đợi Semaphore quá lâu → 429 "busy" (ms, 0 = chờ mãi). Request có thể gửi queue_timeout_ms riêng
GEMINI_QUEUE_TIMEOUT_MS=60000
# 1 lần gọi Gemini quá lâu → 504 và nhả luồng (ms, 0 = không giới hạn)
GEMINI_REQUEST_TIMEOUT_MS=150000

# Đường dẫn file lưu trữ Cookie (tự động xoay vòng __Secure-1PSIDTS)
GEMINI_COOKIES_FILE=cookies.json

# Proxy (Tùy chọn, để trống nếu kết nối trực tiếp)
HTTPS_PROXY=

# ---------- Telegram Monitor & Báo lỗi (giống exam-epu-web) ----------
# Bot token lấy từ @BotFather, Chat ID nhóm Monitor (vd: -5280042435). Để trống = tắt gửi Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-5280042435

# Bật/tắt gửi cảnh báo request chậm & event loop đứng về Telegram (true | false)
MONITOR_ENABLED=true
# Báo khi 1 request AI chậm hơn ngưỡng này (ms). 0 = tắt. (Mặc định 15000ms = 15 giây)
MONITOR_SLOW_MS=15000
# Báo khi luồng xử lý Python (event loop) bị đứng lâu hơn ngưỡng này (ms). 0 = tắt.
MONITOR_LAG_MS=500
# In mọi request & nội dung tin Telegram ra console / pm2 logs (1 = bật, 0 = tắt)
MONITOR_DEBUG=0
