# Mẫu biến môi trường cho Gemini WebAPI Provider.
# Copy file này thành .env (cp .env.example .env) khi triển khai trên máy hoặc VPS.

# ---------- Cấu hình Mạng & Bảo mật ----------
# Để localhost (hoặc 127.0.0.1) để chỉ các Backend trên cùng VPS gọi được, chặn truy cập từ ngoài internet
GEMINI_HOST=localhost
GEMINI_PORT=8000

# Secret Key bắt buộc trong header "Authorization: Bearer <key>" hoặc "X-API-Key: <key>" khi gọi /v1/*
GEMINI_API_KEY=minhdan2k4A@123

# ---------- Hiệu năng & Cookie ----------
# Số luồng xử lý song song tối đa qua Semaphore
GEMINI_MAX_CONCURRENCY=3

# Đường dẫn file lưu trữ Cookie (tự động xoay vòng __Secure-1PSIDTS)
GEMINI_COOKIES_FILE=cookies.json

# Proxy (Tùy chọn, để trống nếu kết nối trực tiếp)
HTTPS_PROXY=
